# ══════════════════════════════════════════════════════════════
# 모이머(Moimer) app-v2 — 환경변수
#
#   cp .env.example .env.local  후 값을 채우세요 (.env.local 은 커밋되지 않습니다)
#
#   ⚠️ Vercel 에 올릴 때: 이 값들은 파일이 아니라 Vercel 프로젝트의
#      Settings → Environment Variables 에 하나씩 직접 넣어야 합니다.
#      그리고 Settings → General → Root Directory 를 **app-v2** 로 지정해야
#      "No Next.js version detected" 오류 없이 빌드됩니다 — Next.js 앱은
#      저장소 루트가 아니라 이 폴더 안에 있습니다.
# ══════════════════════════════════════════════════════════════

# ── Neon Postgres (모임·참가자·투표 영속 저장) ──────────────────
#  console.neon.tech → 프로젝트 → Connect 의 Connection string 을 그대로 복사.
#  ⚠️ 이 값 하나에 비밀번호까지 다 들어 있습니다 — 절대 커밋/공유 금지.
DATABASE_URL=

# ── NextAuth (로그인 세션) ───────────────────────────────────────
#  NEXTAUTH_SECRET: `openssl rand -base64 32` 로 아무 값이나 지어도 됩니다.
#    로컬과 Vercel 이 **다른 값**을 써도 되지만, 한 배포 안에서는 재배포해도
#    바뀌면 안 됩니다 — 바뀌면 이미 로그인해 있던 사람 세션이 전부 끊깁니다.
#  NEXTAUTH_URL: 로컬은 http://localhost:3000, Vercel 은 실제 배포 도메인
#    (예: https://<프로젝트>.vercel.app 또는 커스텀 도메인)으로 **반드시** 설정하세요.
#    비워 두면 카카오 로그인 왕복 중 콜백 주소가 어긋날 수 있습니다.
NEXTAUTH_SECRET=
NEXTAUTH_URL=

# ── 카카오 (로그인 + 지도 + 지오코딩/장소검색) ──────────────────
#  developers.kakao.com → 내 애플리케이션
#  · REST API 키: 서버에서 로컬 검색(지오코딩·가게) + OAuth 토큰 교환
#  · JavaScript 키: 브라우저 지도 SDK. 플랫폼 > Web 에 도메인 등록 필요
#    (Vercel 로 옮기면 그 도메인도 여기에 새로 등록해야 지도가 뜬다)
#  · 로그인을 쓰려면 카카오 로그인 활성화 + Redirect URI 등록 필요
#    — 이 값과 콘솔 등록 값이 **똑같아야** 한다(next.config.mjs 의 rewrite 가
#    이 값을 그대로 읽는다). Vercel 도메인으로 옮기면 콘솔에도 새 Redirect URI 를
#    추가로 등록하고 이 값도 그 주소로 바꿔야 한다 — 한쪽만 바꾸면 KOE006.
KAKAO_REST_API_KEY=
NEXT_PUBLIC_KAKAO_JS_KEY=
KAKAO_REDIRECT_URI=

# ── ODsay (대중교통 길찾기) ───────────────────────────────────────
#  lab.odsay.com — 무료 1,000콜/일. 서버 공인 IP 화이트리스트 필요.
#  ⚠️ Vercel(서버리스)은 나가는 IP 가 고정이 아니다 — 화이트리스트가
#     막히면 이 기능만 조용히 폴백(도보 시간 환산)한다. 막히면 ODsay 쪽에
#     "고정 아웃바운드 IP" 옵션이나 프록시가 필요할 수 있다.
ODSAY_API_KEY=

# ── TMAP (자차 경로) ──────────────────────────────────────────────
TMAP_APP_KEY=

# ── AI 추천 (Ollama) ──────────────────────────────────────────────
#  ⚠️ Vercel 에서 실제로 확인한 것 — 그대로 적는다:
#    · 사내망 주소(예: http://10.20.2.164:11434/v1)나 localhost 는 Vercel 서버가
#      **절대 못 닿는다** (사설 IP다). Vercel 에서 쓰려면 OLLAMA_PRIMARY_URL 을
#      공개 주소인 https://ollama.com/v1 로 둬야 한다(OpenAI 호환 API).
#    · (2026-08-22 업데이트) 예전 키로는 glm-5.2(:cloud 포함)가 "this model
#      requires a subscription" 로 403 이 났었는데, 새 키(사용자가 새로 받아 옴)로는
#      실제 200 응답·정상 JSON 답변까지 확인했다 — 그 계정에 구독이 붙어 있다는 뜻.
#      **키가 또 바뀌면 이 확인도 다시 해야 한다** — 안 그러면 같은 403 이 조용히
#      돌아온다(lib/ai.ts 가 못 붙음으로 곱게 처리하니 화면은 안 죽지만 AI 추천만
#      계속 빈손이다).
#    · glm-5.2:cloud 는 답하기 전에 길게 '생각'을 적는 모델이라 응답 시간 편차가
#      크다(실측: 6~13초가 흔하지만 60초를 넘겨 아예 응답이 없을 때도 있었다) —
#      lib/ai.ts 의 시간제한을 35초로 넉넉히 잡고, 그래도 안 되면 FALLBACK 을
#      한 번 더 시도하는 것은 그래서다(장식이 아니라 실측 근거가 있는 값이다).
#    · OLLAMA_FALLBACK_URL(localhost)은 Vercel 에서는 의미가 없다 — 비워 두면
#      lib/ai.ts 가 그냥 건너뛴다(PRIMARY 만 쓴다). 로컬 개발 PC 에 Ollama 를
#      직접 띄워 뒀다면 그 주소를 넣어 둬도 된다 — 다만 거기 실제로 있는
#      모델 이름을 적어야 한다(`ollama list`로 확인). 없는 모델 이름을 적어
#      두면 "model not found" 로 fallback 도 함께 못 붙는다.
OLLAMA_PRIMARY_URL=
OLLAMA_PRIMARY_MODEL=
OLLAMA_FALLBACK_URL=
OLLAMA_FALLBACK_MODEL=
OLLAMA_API_KEY=
