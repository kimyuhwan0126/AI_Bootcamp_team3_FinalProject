# ══════════════════════════════════════════════════════════════
# 모이머(Moimer) v8 — 환경변수
#
#   cp .env.example .env.local  후 값을 채우세요 (.env.local 은 커밋되지 않습니다)
#   값을 비워두면 해당 기능은 자동으로 mock/인메모리로 폴백합니다 —
#   아무 키 없이 `npm run dev` 만으로 전체 플로우 시연이 가능합니다.
#
#   현재 설정 상태는 http://localhost:3000/api/status 에서 확인할 수 있고,
#   실제 API 호출까지 확인하려면 /api/diag 를 여세요.
#
#   ⚠️ 이 저장소의 dev 포트는 3000 입니다 (package.json: next dev -p 3000).
#      발표용 LAN 시연(팀원 폰에서 IP 접속)은 docs/발표_로컬시연.md 를 보세요.
# ══════════════════════════════════════════════════════════════

# ── Neon Postgres (모임·참가자·투표 영속 저장) ──────────────────
#  console.neon.tech → 프로젝트 → Connect 의 Connection string 을 그대로 복사.
#  형식: postgresql://사용자:비밀번호@호스트/DB이름?sslmode=require
#
#  ⚠️ 이 값 하나에 비밀번호까지 다 들어 있습니다 — 절대 커밋/공유 금지.
#     서버 전용이므로 NEXT_PUBLIC_ 을 붙이지 마세요(붙이면 브라우저에 노출됩니다).
#
#  db/schema.sql 을 Neon SQL Editor 에 붙여 한 번 실행해야 테이블이 만들어집니다.
#  미설정 시 인메모리로 동작하지만, 서버를 재시작하면 모임이 사라지고
#  Vercel(서버리스)에서는 인스턴스마다 데이터가 달라 정상 동작하지 않습니다.
DATABASE_URL=

# ── 카카오 (로그인 + 지도 + 지오코딩/장소검색) ──────────────────
#  developers.kakao.com → 내 애플리케이션
#  · REST API 키: 서버에서 로컬 검색(지오코딩·가게·주차장) + OAuth 토큰 교환
#  · JavaScript 키: 브라우저 지도 SDK. 플랫폼 > Web 에 도메인 등록 필요
#  · 로그인을 쓰려면 카카오 로그인 활성화 + Redirect URI 등록 필요
#
#  ⚠️ REDIRECT URI 는 콘솔 등록값과 **글자 하나까지 같아야** 합니다 (포트 포함).
#     · 내 PC 에서만 볼 때      http://localhost:3000/api/auth/kakao/callback
#     · 팀원 폰에서 접속할 때    http://<노트북IP>:3000/api/auth/kakao/callback
#       (이때 [플랫폼 > Web > 사이트 도메인] 에도 http://<노트북IP>:3000 을 등록해야
#        지도 SDK 가 뜹니다. 자세히는 docs/발표_로컬시연.md §3)
KAKAO_REST_API_KEY=
NEXT_PUBLIC_KAKAO_JS_KEY=
KAKAO_REDIRECT_URI=http://localhost:3000/api/auth/kakao/callback

# ── ODsay (대중교통 길찾기 · 실경로 폴리라인) ───────────────────
#  lab.odsay.com — 무료 1,000콜/일.
#  ⚠️ 서버 키는 "호출하는 서버의 공인 IP"를 화이트리스트에 등록해야 통합니다.
#     현재 서버 IP는 /api/diag 응답의 callerIP 로 확인하세요.
ODSAY_API_KEY=

#  ── ODsay 프록시 (Vercel 배포용) ──
#  Vercel 서버리스는 나가는 IP 가 유동이라 위 화이트리스트에 등록할 수가 없습니다.
#  고정 IP 를 가진 프록시(예: 노트북 + Cloudflare Tunnel)를 거치게 하려면 주소를 넣으세요.
#
#  ⚠️ **비워두면 api.odsay.com 으로 직접 호출합니다 — 지금까지와 똑같이 동작합니다.**
#     로컬 개발에서는 보통 비워둡니다(집·사무실 IP 를 화이트리스트에 넣으면 됩니다).
#  ⚠️ 끝 슬래시와 앞뒤 공백은 코드가 떼어냅니다(터널 주소 복사 시 흔히 딸려옵니다).
#  ⚠️ 터널이 죽으면 자동으로 거리 추정으로 폴백하고, 화면에 "거리 추정으로 계산"이 뜹니다.
ODSAY_BASE_URL=
#  프록시가 요구하는 공유 비밀 — 있으면 x-proxy-secret 헤더로 보냅니다. 비우면 안 보냅니다.
ODSAY_PROXY_SECRET=

# ── TMAP (자차 경로 · 통행료 · 실경로 폴리라인) ─────────────────
#  openapi.sk.com — SK Open API appKey
TMAP_APP_KEY=

# ── 기능 플래그 (lib/flags.ts) ──────────────────────────────────
#  1 = 켬, 그 외 = 끔. 껐다 켜는 걸 코드가 아니라 여기서 한다 —
#  상수를 직접 고치면 브랜치마다 값이 달라져 머지할 때마다 충돌난다.
#  ⚠️ NEXT_PUBLIC_ 로 시작하는 값은 빌드 시점에 박히므로, 바꾸면 서버를 재시작해야 한다.
#
#  AI 파실리테이터 채팅 UI. 끄면 투표 UI 로 대체된다(코드는 보존).
NEXT_PUBLIC_FF_AI_CHAT=0
#  실시간 전송(WebSocket/Realtime). 끄면 기존 1.8초 폴링. (미구현)
NEXT_PUBLIC_FF_REALTIME=0
#  날씨를 추천 점수에 반영. (미구현 — lib/scoring/weather.ts)
NEXT_PUBLIC_FF_WEATHER=0
#  개인별 선호 알고리즘. (미구현 — lib/scoring/personal.ts)
NEXT_PUBLIC_FF_PERSONAL=0
#  ODsay 진단 모드 — 로컬 실측 전용. ⚠️ 배포(Vercel)에는 절대 1 로 두지 마세요.
#   켜면 ① 껍데기 응답 가드를 우회해 시외 원시 응답이 보이고(⚠ 검증 안 됨 표시가 붙습니다)
#        ② 경로 캐시를 건너뛰어 같은 좌표를 반복 호출할 수 있습니다.
#   💰 ODsay 무료 한도(1,000콜/일)를 빠르게 소모하므로 확인이 끝나면 0 으로 되돌리세요.
NEXT_PUBLIC_FF_ODSAY_PROBE=0

# ── AI 모임 도우미 (Ollama) ─────────────────────────────────────
#  v8에서는 UI 진입점이 비활성입니다(NEXT_PUBLIC_FF_AI_CHAT=0).
#  다시 켤 때를 위해 설정만 남겨 둡니다. 1순위 접속 불가 시 2순위로 자동 전환.
#  ⚠️ Ollama 가 없어도 lib/parse.ts(규칙 기반)가 날짜·시간·예산을 뽑습니다.
#     AI 는 그 결과를 보강하는 역할이지 필수가 아닙니다.
#  ⚠️ :cloud 모델은 대화가 Ollama 클라우드로 전송됩니다.
#  ⚠️ 1순위 주소는 팀 내부망 주소라 저장소에 적지 않는다(공개 저장소).
#     쓸 사람이 자기 .env.local 에만 넣는다. 비우면 2순위(localhost)로 간다.
#
#  ── Ollama Cloud 를 직접 쓸 때 ──
#  URL 을 https://ollama.com/v1 로 두고 API 키를 넣는다(ollama.com → Settings → Keys).
#  ⚠️ 모델 ID 에 `:cloud` 를 붙이지 않는다 — 그건 로컬 ollama 가 클라우드로 중계할 때의
#     표기이고, 클라우드 API 에는 그런 ID 가 없다(`glm-5.2:cloud` ✗ / `glm-5.2` ✓).
#  ⚠️ 키를 비워두면 "ollama" 가 들어가며 기존 로컬 동작 그대로다 — 로컬 Ollama 는
#     토큰을 검사하지 않는다.
#  💰 클라우드 모델은 호출량이 과금/한도 대상이다.
#  ⚠️ `glm-5.2` 는 추론 모델이다 — 사고 과정을 `message.reasoning` 에 쓰고 답은 `content` 에
#     담는다. **`max_tokens` 를 낮게 걸면 사고 도중 잘려 `content` 가 빈 문자열로 온다**
#     (64 로 두니 completion 64 토큰을 다 쓰고 본문이 비었다 — 실측). 지금 `lib/ai.ts` 는
#     `max_tokens` 를 보내지 않으므로 문제없다. 넣으려거든 넉넉히 잡는다.
OLLAMA_PRIMARY_URL=
OLLAMA_PRIMARY_MODEL=glm-5.2:cloud
OLLAMA_PRIMARY_API_KEY=
OLLAMA_FALLBACK_URL=http://localhost:11434/v1
OLLAMA_FALLBACK_MODEL=qwen2.5-coder:7b
OLLAMA_FALLBACK_API_KEY=

# ── 개발 도구 ───────────────────────────────────────────────────
#  운영 빌드에서 /api/debug · /api/diag · /api/ai-trace · 카카오 로그인 진단을
#  열어야 할 때만 1로 둡니다. (로컬 `npm run dev` 는 이 값과 무관하게 열립니다)
#
#  ⚠️ 끄려면 값을 0 으로 두지 말고 **이 줄을 지우거나 주석 처리**하세요.
#     정확히 "1" 일 때만 열리지만, 애초에 없는 편이 안전합니다.
#  ⚠️ Vercel 환경변수에는 넣지 마세요 — /api/diag 는 외부 API 설정 상태와
#     서버 공인 IP 를, /api/debug 는 모임 생성을 외부에 열어줍니다.
# ENABLE_DEBUG=1
