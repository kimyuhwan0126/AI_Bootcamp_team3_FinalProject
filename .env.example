# ── 모이머 v2 환경변수 (.env.local 로 복사해 값을 채우세요) ──
# 값을 비워두면 해당 API는 자동으로 mock 폴백으로 동작합니다.

# 카카오 (로그인 + 지도/지오코딩)
KAKAO_REST_API_KEY=
NEXT_PUBLIC_KAKAO_JS_KEY=
KAKAO_REDIRECT_URI=http://localhost:3000/api/auth/kakao/callback

# ODsay (대중교통 길찾기) — 서버 키는 호출 IP 화이트리스트 등록 필요
ODSAY_API_KEY=

# TMAP (자차 경로) — SK Open API appKey
TMAP_APP_KEY=

# AI 모임 도우미 (Ollama · 투표 대체 대화)
# 1순위 접속 불가 시 자동으로 2순위(fallback)로 전환됩니다.
OLLAMA_PRIMARY_URL=http://10.20.2.164:11434/v1
OLLAMA_PRIMARY_MODEL=glm-5.2:cloud
OLLAMA_FALLBACK_URL=http://localhost:11434/v1
OLLAMA_FALLBACK_MODEL=qwen2.5-coder:7b

# (운영) Neon Postgres — 미설정 시 인메모리 스토어 사용
# DATABASE_URL=
